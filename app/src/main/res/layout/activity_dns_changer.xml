<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F5F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- DNS Status Header -->
        <LinearLayout
            android:id="@+id/status_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/status_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DNS Status: Disconnected"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1F1F2F"
                android:layout_gravity="center" />

            <Button
                android:id="@+id/btn_toggle_vpn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="CONNECT"
                android:backgroundTint="#6C63FF"
                android:textColor="#FFFFFF" />

        </LinearLayout>

        <!-- Search input placeholder -->
        <EditText
            android:id="@+id/search_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Search DNS presets..."
            android:singleLine="true"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <!-- Selection placeholder -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cloudflare DNS"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.1.1.1 | 1.0.0.1"
                android:textColor="#6C63FF"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Custom Manual Input fields -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Custom DNS"
                android:textStyle="bold"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/custom_primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Primary IP (e.g. 1.1.1.1)"
                android:layout_marginTop="8dp" />

            <EditText
                android:id="@+id/custom_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Secondary IP (e.g. 1.0.0.1)"
                android:layout_marginTop="8dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
